# Copy to .env and replace each value with a strong local development secret.
POSTGRES_USER=postgresuser
POSTGRES_PASSWORD=replace-with-a-unique-password
POSTGRES_DB=oneshop

AWS_ACCESS_KEY_ID=replace-with-seaweedfs-access-key
AWS_SECRET_ACCESS_KEY=replace-with-seaweedfs-secret-key

SUPERSET_SECRET_KEY=replace-with-a-long-random-secret
SUPERSET_ADMIN_USERNAME=admin
SUPERSET_ADMIN_PASSWORD=replace-with-a-unique-password
SUPERSET_DB_PASSWORD=replace-with-a-unique-password
SUPERSET_DATABASE_URL=postgresql+psycopg2://superset:replace-with-a-unique-password@superset-db:5432/superset

CLICKHOUSE_PASSWORD=replace-with-a-unique-password

AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=replace-with-a-unique-password
AIRFLOW_DB_URL=postgresql+psycopg2://airflow:replace-with-a-unique-password@airflow-db/airflow
AIRFLOW_SECRET_KEY=replace-with-a-long-random-secret
AIRFLOW_ADMIN_USERNAME=admin
AIRFLOW_ADMIN_PASSWORD=replace-with-a-unique-password
